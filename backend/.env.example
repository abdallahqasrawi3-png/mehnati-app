# Copy to .env and fill in real values. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: list the web app origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8081

DB_NAME=mehnaty
DB_USER=mehnaty
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=Asia/Hebron
MAX_IMAGE_UPLOAD_MB=5
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# Optional AI assistant (Claude). Without a key the app uses its built-in rule-based assistant.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

# Test/demo only: fake carrier, never a real delivery company.
SHIPPING_SIMULATOR_ENABLED=false
